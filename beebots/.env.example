# beebots on Vercel — copy to .env.local for local runs, set the same vars in Vercel.
# Paper trading is the only supported mode in this build. DRY_RUN is a hard latch.

# ---- Engine --------------------------------------------------------------------
TICK_SECONDS=60
JEV_DAILY_USD_CAP=0.20
JEV_MODEL=typesafe-ai/jev
JEV_TIMEOUT_MS=2500

# ---- Jev provider (pick ONE) -----------------------------------------------------
# A) Vercel AI Gateway (recommended, no extra account): set nothing here; on Vercel
#    the AI Gateway key is injected as AI_GATEWAY_API_KEY automatically. Locally:
# AI_GATEWAY_API_KEY=
# B) Any OpenAI-compatible endpoint (OpenRouter "typesafe/jev-1.13", self-hosted...):
# OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=typesafe/jev-1.13

# ---- Database (Supabase free tier: use the POOLED connection string, port 6543) --
DATABASE_URL=postgresql://...pooler.supabase.com:6543/postgres

# ---- Loop security ---------------------------------------------------------------
# The external scheduler sends this as the x-cron-secret header on /api/tick.
# Vercel Cron sends it to /api/watchdog as a Bearer token automatically.
CRON_SECRET=
# sha256 of the dashboard owner password (echo -n "pass" | shasum -a 256). Empty = admin API disabled.
OWNER_PASSWORD_HASH=

# ---- Mode ------------------------------------------------------------------------
DRY_RUN=true

# ---- Risk (defaults ported from beebots .env.example / COSTS.md) ------------------
BEE_START_EQUITY_USD=333
MAX_LEVERAGE=2
DAILY_LOSS_STOP_PCT=8
BEE_RETIRE_AT_PCT=40
MAX_NOTIONAL_USD_PER_BEE=700
MIN_24H_VOL_USD=1000000
BREAKOUT_SPREAD_GATE_BPS=5
MOMENTUM_SPREAD_GATE_BPS=15
