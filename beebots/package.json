{
  "name": "beebots-vercel",
  "version": "0.1.0",
  "description": "Three AI trading bees on Vercel: OKX public market data, Jev decisions, code-enforced risk, paper-trading ledger. A Vercel + Postgres port of imikerussell/beebots (MIT).",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start -p 3200",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tick:once": "tsx scripts/tick-once.ts",
    "schema": "tsx scripts/apply-schema.ts"
  },
  "dependencies": {
    "next": "^15.5.25",
    "postgres": "^3.4.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
